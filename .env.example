# Pilot reads these from the environment of the process that starts it
# (the server does not load a .env file). Never put a real key in this file.

# Burner testnet key, needed only to place orders. Set it in your shell, e.g.
#   read -rs PILOT_PRIVATE_KEY && export PILOT_PRIVATE_KEY
# PILOT_PRIVATE_KEY=

# Public address for read-only use without a key (reads).
# PILOT_ACCOUNT=0x...

# Optional paths and endpoint overrides.
# PILOT_HOME=~/.pilot
# PILOT_POLICY=~/.pilot/policy.json
# PILOT_JOURNAL=~/.pilot/journal.jsonl
# PILOT_INDEXER_URL=
